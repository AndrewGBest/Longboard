{
  "name": "longboard",
  "version": "0.3.29",
  "description": "A web browser for the TV, driven by a remote or game controller.",
  "private": true,
  "license": "GPL-3.0-only",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && node scripts/check-rules.mjs",
    "start": "npm run build && electron . --dev",
    "e2e": "npm run build && node test/e2e/run.mjs",
    "dist": "npm run build && electron-builder --linux",
    "tv": "npm run build && electron .",
    "scorecard": "npm run build && node test/scorecard/run.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e:package": "npm run build && electron-builder --linux dir --publish never && LONGBOARD_APP=\"$(ls -d release/linux*-unpacked)/longboard\" node test/e2e/run.mjs"
  },
  "build": {
    "appId": "io.github.andrewgbest.Longboard",
    "productName": "Longboard",
    "artifactName": "Longboard-${arch}.${ext}",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "files": [
      "dist/**",
      "profiles/**",
      "assets/**",
      "package.json"
    ],
    "linux": {
      "category": "Network",
      "synopsis": "Web browser for the TV",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "assets/icon.png",
      "syncDesktopName": true
    },
    "directories": {
      "output": "release"
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "finishArgs": [
        "--share=ipc",
        "--share=network",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--device=all",
        "--filesystem=xdg-data/applications:create",
        "--talk-name=org.freedesktop.ScreenSaver",
        "--talk-name=org.freedesktop.PowerManagement",
        "--own-name=org.mpris.MediaPlayer2.chromium.*"
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^26.0.0",
    "prettier": "3.10.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "author": "Longboard contributors",
  "desktopName": "io.github.andrewgbest.Longboard.desktop",
  "dependencies": {
    "@ghostery/adblocker": "^2.20.3",
    "@moonshine-ai/moonshine-wasm": "0.1.6",
    "adm-zip": "0.6.1",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0",
    "qrcode-generator": "^2.0.4",
    "tweetnacl": "^1.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://andrewgbest.github.io/Longboard/",
  "bugs": {
    "url": "https://github.com/AndrewGBest/Longboard/issues"
  },
  "overrides": {
    "adm-zip": "0.6.1"
  }
}
